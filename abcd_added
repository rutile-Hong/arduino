#include <SD.h>
#include <Keypad.h>
#include <Servo.h>
#include <Wire.h>

/* ==========================================================
   PID HOLD-FAIL VERSION for gust generator vein actuator
   ----------------------------------------------------------
   Purpose:
   - keep the original vane motion modes and max-amplitude logic
   - add a dedicated hold-failure mode that simulates a PID
     controller losing position holding
   - use key 'P' to toggle the hold-failure behavior
   ========================================================== */

Servo actuator;
const int servoPin = 9;
const int POS_MIN  = 1100;
const int POS_MAX  = 1800;
const int POS_STOP = 1440;
const int POS_TEN  = 1400;
const int POS_TWN  = 1600;
const unsigned long KEY5_DELAY = 1370;

int posMin = POS_MIN;
int posMax = POS_MAX;
const int BASE_DELAY = 800;
const int BASE_AMP = 200; // 1640-1440

unsigned long actuatorDelay = 900;
unsigned long lastChange = 0;
bool extendState = false;
bool centerHold = false;
bool key5Mode = false;
bool pidHoldFailMode = false;
bool stuckFailMode = false;
bool abruptStepFailMode = false;
byte key5State = 0;
unsigned long key5Timer = 0;
unsigned long holdFailStart = 0;
int lastServoUs = POS_STOP;

void updateAmplitude() {
  float scale = (float)actuatorDelay / BASE_DELAY;
  int amp = BASE_AMP * scale;
  posMin = POS_STOP - amp;
  posMax = POS_STOP + amp;
}

void setActuatorUs(int us) {
  static int lastUs = -1;
  lastServoUs = us;
  if (us != lastUs) {
    actuator.writeMicroseconds(us);
    lastUs = us;
  }
}

/* ================= SD ================= */
const int SD_CS_PIN = 4;
File logFile;

void sdInitOrHalt() {
  pinMode(10, OUTPUT);
  digitalWrite(10, HIGH);
  if (!SD.begin(SD_CS_PIN)) {
    while (1) {}
  }

  logFile = SD.open("log.csv", FILE_WRITE);
  if (!logFile) {
    while (1) {}
  }

  if (logFile.size() == 0) {
    logFile.println("count,timeMs,angle,i2cErr");
    logFile.flush();
  }
}

/* ================= TIMER / LOGGING ================= */
uint32_t lastLogTime = 0;
const uint32_t LOG_INTERVAL_US = 2000;

/* ================= AS5600 ================= */
#define AS5600_ADDR 0x36
#define AS5600_RAW_ANGLE_REG 0x0C

uint16_t angleNow = 0;
uint16_t anglePrev = 0;
int32_t Counter = 0;
uint16_t i2cErrors = 0;

bool readAS5600RawAngle(uint16_t &outAngle) {
  Wire.beginTransmission(AS5600_ADDR);
  Wire.write(AS5600_RAW_ANGLE_REG);
  if (Wire.endTransmission(false) != 0) return false;
  if (Wire.requestFrom(AS5600_ADDR, 2) != 2) return false;
  uint16_t high = Wire.read();
  uint16_t low  = Wire.read();
  outAngle = ((high << 8) | low) & 0x0FFF;
  return true;
}

/* ================= KEYPAD ================= */
const byte ROWS = 4, COLS = 4;
char keys[ROWS][COLS] = {
  {'1','2','3','A'},
  {'4','5','6','B'},
  {'7','8','9','C'},
  {'*','0','#','D'}
};
byte rowPins[ROWS] = {A1, A2, 5, 6};
byte colPins[COLS] = {A3, A0, 7, 8};
Keypad keypad = Keypad(makeKeymap(keys), rowPins, colPins, ROWS, COLS);

void handleKeypad() {
  char key = keypad.getKey();

  if (key == NO_KEY) {
    return;
  }

  Serial.print("Key pressed: ");
  Serial.println(key);

  // Key 0: normal center hold
  if (key == '0') {
    key5Mode = false;
    pidHoldFailMode = false;
    stuckFailMode = false;
    abruptStepFailMode = false;
    centerHold = true;
    extendState = false;
    holdFailStart = millis();
    setActuatorUs(POS_STOP);

    Serial.println("Normal center hold enabled");
    return;
  }

  // Key A: PID hold-failure (drift away from center)
  if (key == 'A') {
    key5Mode = false;
    pidHoldFailMode = !pidHoldFailMode;
    stuckFailMode = false;
    abruptStepFailMode = false;
    centerHold = true;
    extendState = false;
    holdFailStart = millis();

    if (pidHoldFailMode) {
      Serial.println("PID hold-fail enabled: vane will drift from center");
    } else {
      Serial.println("PID hold-fail disabled: center hold restored");
      setActuatorUs(POS_STOP);
    }
    return;
  }

  // Key B: stuck actuator failure (keeps last command)
  if (key == 'B') {
    key5Mode = false;
    pidHoldFailMode = false;
    stuckFailMode = !stuckFailMode;
    abruptStepFailMode = false;
    centerHold = true;
    extendState = false;
    holdFailStart = millis();

    if (stuckFailMode) {
      Serial.println("Stuck actuator failure enabled: vane holds last command");
    } else {
      Serial.println("Stuck actuator failure disabled");
      setActuatorUs(POS_STOP);
    }
    return;
  }

  // Key C: abrupt step failure (fast jump away from center)
  if (key == 'C') {
    key5Mode = false;
    pidHoldFailMode = false;
    stuckFailMode = false;
    abruptStepFailMode = !abruptStepFailMode;
    centerHold = true;
    extendState = false;
    holdFailStart = millis();

    if (abruptStepFailMode) {
      Serial.println("Abrupt step failure enabled: vane jumps away from center");
    } else {
      Serial.println("Abrupt step failure disabled");
      setActuatorUs(POS_STOP);
    }
    return;
  }

  // Key D: disable all failure modes
  if (key == 'D') {
    key5Mode = false;
    pidHoldFailMode = false;
    stuckFailMode = false;
    abruptStepFailMode = false;
    centerHold = true;
    extendState = false;
    holdFailStart = millis();
    setActuatorUs(POS_STOP);
    Serial.println("All fail modes disabled");
    return;
  }

  // Key 5: repeating sequence
  if (key == '5') {
    key5Mode = true;
    pidHoldFailMode = false;
    centerHold = true;
    extendState = false;

    key5State = 0;
    key5Timer = millis();

    setActuatorUs(POS_MIN);
    Serial.println("Key 5 repeating mode started");
    return;
  }

  // Key 8: hold at minimum position
  if (key == '8') {
    key5Mode = false;
    pidHoldFailMode = false;
    centerHold = true;
    extendState = false;
    setActuatorUs(POS_MIN);
    Serial.print("Holding at minimum: ");
    Serial.println(POS_MIN);
    return;
  }

  // Key 9: hold at maximum position
  if (key == '9') {
    key5Mode = false;
    pidHoldFailMode = false;
    centerHold = true;
    extendState = false;
    setActuatorUs(POS_MAX);
    Serial.print("Holding at maximum: ");
    Serial.println(POS_MAX);
    return;
  }

  // Normal oscillation modes
  bool validOscillationKey = true;
  pidHoldFailMode = false;
  stuckFailMode = false;
  abruptStepFailMode = false;

  switch (key) {
    case '1':
      actuatorDelay = 340;
      break;

    case '2':
      actuatorDelay = 510;
      break;

    case '3':
      actuatorDelay = 680;
      break;

    case '4':
      actuatorDelay = 1360; // maximum amplitude mode
      break;

    default:
      validOscillationKey = false;
      break;
  }

  if (!validOscillationKey) {
    Serial.println("No function assigned");
    return;
  }

  key5Mode = false;
  centerHold = false;
  extendState = false;

  updateAmplitude();
  setActuatorUs(POS_STOP);
  lastChange = millis();
}

void handleKey5Mode() {
  if (!key5Mode) {
    return;
  }

  unsigned long waitTime;

  if (key5State == 2) {
    waitTime = KEY5_DELAY * 2;
  } else {
    waitTime = KEY5_DELAY;
  }

  if (millis() - key5Timer < waitTime) {
    return;
  }

  key5Timer = millis();

  switch (key5State) {
    case 0:
      setActuatorUs(POS_MAX);
      key5State = 1;
      break;

    case 1:
      setActuatorUs(POS_STOP);
      key5State = 2;
      break;

    case 2:
      setActuatorUs(POS_MIN);
      key5State = 0;
      break;
  }
}

/* ================= ACTUATOR ================= */
void handleActuator() {
  if (centerHold) {
    if (pidHoldFailMode) {
      unsigned long dt = millis() - holdFailStart;

      // Simulate a PID or servo controller losing position-hold ability.
      // It drifts away from center and then oscillates around the failed setpoint.
      int drift = 0;

      if (dt < 1500) {
        drift = map(dt, 0, 1500, 0, 180);
      } else {
        drift = 180 + ((int)((dt / 350) % 8) - 3) * 35;
      }

      if ((dt / 450) % 2 == 0) {
        drift = -drift;
      }

      setActuatorUs(POS_STOP + drift);
      return;
    }

    if (stuckFailMode) {
      // Mechanical stall: vane stays at the last command and will not correct.
      setActuatorUs(lastServoUs);
      return;
    }

    if (abruptStepFailMode) {
      // Sudden step failure: vane jumps to one side and then alternates.
      unsigned long dt = millis() - holdFailStart;
      int step = ((dt / 400) % 2 == 0) ? 220 : -220;
      setActuatorUs(POS_STOP + step);
      return;
    }

    setActuatorUs(POS_STOP);
    return;
  }

  if (millis() - lastChange >= actuatorDelay) {
    lastChange = millis();
    extendState = !extendState;
    setActuatorUs(extendState ? posMax : posMin);
  }
}

/* ================= LOGGING (CSV) ================= */
void handleEncoderAndLogging() {
  uint32_t nowUs = micros();
  if ((uint32_t)(nowUs - lastLogTime) < LOG_INTERVAL_US) return;
  lastLogTime += LOG_INTERVAL_US;

  uint16_t a;
  if (!readAS5600RawAngle(a)) {
    i2cErrors++;
    return;
  }

  angleNow = a;
  int16_t d = angleNow - anglePrev;
  if (d > 2048)  d -= 4096;
  if (d < -2048) d += 4096;
  Counter += d;
  anglePrev = angleNow;

  unsigned long tMs = millis();

  logFile.print((int32_t)Counter);
  logFile.print(',');
  logFile.print(tMs);
  logFile.print(',');
  logFile.print(angleNow);
  logFile.print(',');
  logFile.println(i2cErrors);
}

/* ================= SETUP ================= */
void setup() {
  Serial.begin(115200);
  Wire.begin();
  Wire.setClock(100000);

  sdInitOrHalt();

  actuator.attach(servoPin);
  setActuatorUs(POS_STOP);
  updateAmplitude();

  for (int i = 0; i < 20; i++) {
    uint16_t a;
    if (readAS5600RawAngle(a)) {
      angleNow = anglePrev = a;
      break;
    }
    delay(10);
  }
}

/* ================= LOOP ================= */
void loop() {
  handleKeypad();
  handleKey5Mode();
  handleEncoderAndLogging();
  handleActuator();

  static uint32_t lastFlush = 0;
  if (millis() - lastFlush >= 50) {
    logFile.flush();
    lastFlush = millis();
  }
}
