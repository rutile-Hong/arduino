#include <Servo.h>
#include <Keypad.h>
#include <Wire.h>
#include <SD.h>

/* ==========================================================
   Second lean version: supports both keypad and Serial, plus encoder + SD logging
   ----------------------------------------------------------
   Use one of these commands in Serial Monitor:
   0 = normal center hold
   1 = oscillation mode 1
   2 = oscillation mode 2
   3 = oscillation mode 3
   4 = maximum amplitude mode
   A = PID drift failure
   B = abrupt jump failure
   C = stuck actuator failure
   D = disable all fault modes
   ========================================================== */

Servo actuator;
const int servoPin = 9;
const int POS_MIN  = 1100;
const int POS_MAX  = 1800;
const int POS_STOP = 1440;
const int BASE_DELAY = 800;
const int BASE_AMP = 200;

int posMin = POS_MIN;
int posMax = POS_MAX;
unsigned long actuatorDelay = 900;
unsigned long lastChange = 0;
bool extendState = false;
bool centerHold = false;
bool pidHoldFailMode = false;
bool abruptStepFailMode = false;
bool stuckFailMode = false;
unsigned long holdFailStart = 0;
int lastServoUs = POS_STOP;

void updateAmplitude() {
  float scale = (float)actuatorDelay / BASE_DELAY;
  int amp = BASE_AMP * scale;
  posMin = POS_STOP - amp;
  posMax = POS_STOP + amp;
}

void setActuatorUs(int us) {
  static int lastUs = -1;
  lastServoUs = us;
  if (us != lastUs) {
    actuator.writeMicroseconds(us);
    lastUs = us;
  }
}

/* ================= SD / ENCODER ================= */
const int SD_CS_PIN = 4;
File logFile;
#define AS5600_ADDR 0x36
#define AS5600_RAW_ANGLE_REG 0x0C

uint16_t angleNow = 0;
uint16_t anglePrev = 0;
int32_t Counter = 0;
uint16_t i2cErrors = 0;

bool readAS5600RawAngle(uint16_t &outAngle) {
  Wire.beginTransmission(AS5600_ADDR);
  Wire.write(AS5600_RAW_ANGLE_REG);
  if (Wire.endTransmission(false) != 0) return false;
  if (Wire.requestFrom(AS5600_ADDR, 2) != 2) return false;

  uint16_t high = Wire.read();
  uint16_t low = Wire.read();
  outAngle = ((high << 8) | low) & 0x0FFF;
  return true;
}

void sdInitOrHalt() {
  pinMode(10, OUTPUT);
  digitalWrite(10, HIGH);

  if (!SD.begin(SD_CS_PIN)) {
    while (1) {}
  }

  logFile = SD.open("vein_log.csv", FILE_WRITE);
  if (!logFile) {
    while (1) {}
  }

  if (logFile.size() == 0) {
    logFile.println("count,timeMs,angle,i2cErr");
    logFile.flush();
  }
}

void handleEncoderAndLogging() {
  static uint32_t lastLogTime = 0;
  const uint32_t LOG_INTERVAL_US = 500; // save more frequently for high-resolution logging

  uint32_t nowUs = micros();
  if ((uint32_t)(nowUs - lastLogTime) < LOG_INTERVAL_US) return;
  lastLogTime += LOG_INTERVAL_US;

  uint16_t a;
  if (!readAS5600RawAngle(a)) {
    i2cErrors++;
    return;
  }

  angleNow = a;
  int16_t d = angleNow - anglePrev;
  if (d > 2048) d -= 4096;
  if (d < -2048) d += 4096;
  Counter += d;
  anglePrev = angleNow;

  unsigned long tMs = millis();

  logFile.print((int32_t)Counter);
  logFile.print(',');
  logFile.print(tMs);
  logFile.print(',');
  logFile.print(angleNow);
  logFile.print(',');
  logFile.println(i2cErrors);
}

void setMode(int mode) {
  switch (mode) {
    case 1:
      actuatorDelay = 340;
      break;
    case 2:
      actuatorDelay = 510;
      break;
    case 3:
      actuatorDelay = 680;
      break;
    case 4:
      actuatorDelay = 1360; // maximum amplitude mode
      break;
    default:
      actuatorDelay = 900;
      break;
  }

  pidHoldFailMode = false;
  abruptStepFailMode = false;
  stuckFailMode = false;
  centerHold = false;
  updateAmplitude();
  setActuatorUs(POS_STOP);
  lastChange = millis();
}

void handleCommand(char key) {
  switch (key) {
    case '0':
      pidHoldFailMode = false;
      abruptStepFailMode = false;
      stuckFailMode = false;
      centerHold = true;
      setActuatorUs(POS_STOP);
      Serial.println("Center hold");
      break;

    case '1':
    case '2':
    case '3':
    case '4':
      setMode(key - '0');
      Serial.print("Mode ");
      Serial.println(key);
      break;

    case 'A':
      pidHoldFailMode = !pidHoldFailMode;
      abruptStepFailMode = false;
      stuckFailMode = false;
      centerHold = true;
      holdFailStart = millis();
      
      break;

    case 'B':
      abruptStepFailMode = !abruptStepFailMode;
      pidHoldFailMode = false;
      stuckFailMode = false;
      centerHold = true;
      holdFailStart = millis();
      Serial.println(abruptStepFailMode ? "Abrupt step fail ON" : "Abrupt step fail OFF");
      break;

    case 'C':
      stuckFailMode = !stuckFailMode;
      pidHoldFailMode = false;
      abruptStepFailMode = false;
      centerHold = true;
      holdFailStart = millis();
      Serial.println(stuckFailMode ? "Stuck fail ON" : "Stuck fail OFF");
      break;

    case 'D':
      pidHoldFailMode = false;
      abruptStepFailMode = false;
      stuckFailMode = false;
      centerHold = true;
      setActuatorUs(POS_STOP);
      Serial.println("All faults OFF");
      break;

    default:
      break;
  }
}

void handleActuator() {
  if (centerHold) {
    if (pidHoldFailMode) {
      unsigned long dt = millis() - holdFailStart;
      int drift = 0;

      if (dt < 1500) {
        drift = map(dt, 0, 1500, 0, 180);
      } else {
        drift = 180 + ((int)((dt / 350) % 8) - 3) * 35;
      }

      if ((dt / 450) % 2 == 0) {
        drift = -drift;
      }

      setActuatorUs(POS_STOP + drift);
      return;
    }

    if (abruptStepFailMode) {
      unsigned long dt = millis() - holdFailStart;
      int step = ((dt / 400) % 2 == 0) ? 220 : -220;
      setActuatorUs(POS_STOP + step);
      return;
    }

    if (stuckFailMode) {
      setActuatorUs(lastServoUs);
      return;
    }

    setActuatorUs(POS_STOP);
    return;
  }

  if (millis() - lastChange >= actuatorDelay) {
    lastChange = millis();
    extendState = !extendState;
    setActuatorUs(extendState ? posMax : posMin);
  }
}

const byte ROWS = 4, COLS = 4;
char keys[ROWS][COLS] = {
  {'1','2','3','A'},
  {'4','5','6','B'},
  {'7','8','9','C'},
  {'*','0','#','D'}
};
byte rowPins[ROWS] = {A1, A2, 5, 6};
byte colPins[COLS] = {A3, A0, 7, 8};
Keypad keypad = Keypad(makeKeymap(keys), rowPins, colPins, ROWS, COLS);

void setup() {
  Serial.begin(115200);
  Wire.begin();
  Wire.setClock(100000);

  sdInitOrHalt();

  Serial.println("Vein actuator lean version 2");
  Serial.println("Commands: 0,1,2,3,4,A,B,C,D");
  actuator.attach(servoPin);
  updateAmplitude();
  setActuatorUs(POS_STOP);

  for (int i = 0; i < 20; i++) {
    uint16_t a;
    if (readAS5600RawAngle(a)) {
      angleNow = anglePrev = a;
      break;
    }
    delay(10);
  }
}

void loop() {
  char key = keypad.getKey();
  if (key != NO_KEY) {
    handleCommand(key);
  }

  if (Serial.available() > 0) {
    char cmd = Serial.read();
    if (cmd != '\n' && cmd != '\r') {
      handleCommand(cmd);
    }
  }

  handleEncoderAndLogging();
  handleActuator();

  static uint32_t lastFlush = 0;
  if (millis() - lastFlush >= 20) { // flush more often so data is not lost on restart
    logFile.flush();
    lastFlush = millis();
  }
}
